# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of this app (used in password-reset email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fixed platform admin, created/reset with: npm run create-admin
# Password: at least 12 characters with a letter and a number.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password-1
ADMIN_NAME="MedLife Admin"

# Payments (M8)
# PAYMENT_PROVIDER: "sslcommerz" or "mock" (offline test gateway, never use in production)
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
# true = sandbox.sslcommerz.com, false = live securepay.sslcommerz.com
SSLCOMMERZ_SANDBOX=true

# Video consultations (M9). STUN is built in; add TURN for reliable calls on mobile networks.
# Option A: static TURN credentials
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Option B: Metered.ca (short-lived credentials)
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=

# Notifications (M11)
# SMS_PROVIDER: "bulksmsbd" (real SMS) or "log" (default; messages are only recorded)
SMS_PROVIDER=log
BULKSMSBD_API_KEY=
# Approved sender ID from your BulkSMSBD panel (non-masking number or masking name)
BULKSMSBD_SENDER_ID=
# Random string (32+ chars). Lets the Supabase scheduler call /api/cron/notifications.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
